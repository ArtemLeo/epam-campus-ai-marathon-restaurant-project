            "arn:aws:dynamodb:${region}:${account_id}:table/Notifications",
            "arn:aws:dynamodb:${region}:${account_id}:table/GroupReservations",
            "arn:aws:dynamodb:${region}:${account_id}:table/GuestSessions",
            "arn:aws:dynamodb:${region}:${account_id}:table/Waiters/index/*",
            "arn:aws:dynamodb:${region}:${account_id}:table/${feedback_table_name}/index/*",
            "arn:aws:dynamodb:${region}:${account_id}:table/Tables/index/*",
            "arn:aws:dynamodb:${region}:${account_id}:table/Dishes/index/*",
            "arn:aws:dynamodb:${region}:${account_id}:table/Reservations/index/*",
            "arn:aws:dynamodb:${region}:${account_id}:table/Locations/index/*",
            "arn:aws:dynamodb:${region}:${account_id}:table/ProfileImages/index/*",
            "arn:aws:dynamodb:${region}:${account_id}:table/Orders/index/*",
            "arn:aws:dynamodb:${region}:${account_id}:table/Reports/index/*",
