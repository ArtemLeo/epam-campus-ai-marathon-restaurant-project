{
  "version": "1.0",
  "name": "api-handler",
  "func_name": "main.handler",
  "resource_type": "lambda",
  "iam_role_name": "api-handler-role",
  "runtime": "python3.12",
  "memory": 128,
  "timeout": 100,
  "lambda_path": "lambdas/api_handler",
  "dependencies": [
    {
      "resource_name": "api-handler-role",
      "resource_type": "iam_role"
    }
  ],
  "event_sources": [],
  "env_variables": {
    "COGNITO_USER_POOL_ID": "${user_pool_id}",
    "COGNITO_USER_POOL_CLIENT_ID": "${user_pool_client_id}",
    "reports_queue_name": "${reports_queue_name}",
    "OrderIndexReservationId": "${orders_index_reservation_id}",
    "REGION": "${region}",
    "notificationsTable": "${notifications_table_name}",
    "FEEDBACK_TABLE_NAME": "${feedback_table_name}",
    "locationsTable": "${locations_table}",
    "WaiterListTableName": "${waiter_list_table_name}",
    "tablesTable": "${tables_table}",
    "dishesTable": "${dishes_table}",
    "reservationsTable": "${reservations_table}",
    "reportsTable": "${reports_table_name}",
    "reportsHistoryTable": "${reports_history_table_name}",
    "profileImagesTable": "${profile_images_table_name}",
    "notificationsUserIdIndex": "${notifications_user_id_global_index}",
    "reservationsCustomerIdGlobalIndex": "${reservations_customer_id_global_index}",
    "reservationsWaiterIdGlobalIndex": "${reservations_waiter_id_global_index}",
    "reservationsTableGlobalIndex": "${reservations_table_global_index}",
    "waitersGlobalIndex": "${waiters_global_index}",
    "imagesBucketName": "${images_bucket_name}",
    "profileImagesBucketName": "${profile_images_bucket_name}",
    "ordersTable": "${orders_table}",
    "feedbackGlobalIndex": "${feedback_global_index}",
    "groupReservationsTable": "${group_reservations_table}",
    "guestSessionTable": "${guest_sessions_table}",
    "tableLocationIdIndex": "${tables_location_id_global_index}",
    "RESTAURANT_TIMEZONE": "${restaurant_timezone}"
  },
  "publish_version": true,
  "alias": "${lambdas_alias_name}",
  "logs_expiration": "${logs_expiration}",
  "url_config": {},
  "ephemeral_storage": 512,
  "tags": {}
}
