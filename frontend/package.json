{
  "name": "restaurant-vue-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/set-env.mjs",
    "build": "vue-tsc --build && vite build",
    "postbuild": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "jwt-decode": "^4.0.0",
    "pinia": "^2.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
